<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <a href="/" class="btn btn-secondary btn-sm mb-3">🔙 Ana Sayfaya Dön</a>
                
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Giriş Yap</h4>
                        <form action="/login" method="POST">
                            <input type="text" name="username" class="form-control mb-3" placeholder="Kullanıcı Adı" required>
                            <input type="password" name="password" class="form-control mb-3" placeholder="Şifre" required>
                            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body bg-light">
                        <h4 class="card-title mb-4">Hesabın Yok Mu? Kayıt Ol</h4>
                        <form action="/register" method="POST">
                            <input type="text" name="username" class="form-control mb-3" placeholder="Kendine Bir Kullanıcı Adı Seç" required>
                            <input type="password" name="password" class="form-control mb-3" placeholder="Bir Şifre Belirle" required>
                            <button type="submit" class="btn btn-success w-100">Kayıt Ol</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>