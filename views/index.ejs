<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StoryApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark shadow">
        <div class="container">
            <a class="navbar-brand" href="/">✒️ StoryApp DENEME</a>
            <div>
                <% if (user) { %>
                    <span class="text-white me-3">Merhaba, <%= user.username %></span>
                    <a href="/my-stories" class="btn btn-outline-info btn-sm text-white me-2">📝 Yazılarım</a>
                    <a href="/add" class="btn btn-success btn-sm">Yazı Paylaş</a>
                    <a href="/logout" class="btn btn-danger btn-sm ms-2">Çıkış Yap</a>
                <% } else { %>
                    <a href="/auth" class="btn btn-primary btn-sm">Giriş Yap / Kayıt Ol</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h3 class="mb-4 text-secondary">Son Paylaşılanlar</h3>
        
        <% if (stories.length === 0) { %>
            <div class="alert alert-info">Henüz kimse bir şey yazmamış. İlk yazan sen ol!</div>
        <% } %>

        <div class="row">
            <% stories.forEach(story => { %>
                <div class="col-md-12 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title text-primary"><%= story.title %></h4>
                            <h6 class="card-subtitle mb-3 text-muted">
                                Yazar: <a href="/author/<%= story.author %>" class="text-decoration-none fw-bold text-dark">@<%= story.author %> 🔗</a>
                            </h6>
                            
                            <% if (story.content.length > 400) { %>
                                <div class="collapse show toggle-<%= story._id %>">
                                    <p class="card-text" style="white-space: pre-wrap;"><%= story.content.substring(0, 400) %>...</p>
                                    <button class="btn btn-link p-0 text-decoration-none btn-sm fw-bold" type="button" data-bs-toggle="collapse" data-bs-target=".toggle-<%= story._id %>">Daha Fazla Göster 🔽</button>
                                </div>
                                <div class="collapse toggle-<%= story._id %>">
                                    <p class="card-text" style="white-space: pre-wrap;"><%= story.content %></p>
                                    <button class="btn btn-link p-0 text-decoration-none btn-sm fw-bold" type="button" data-bs-toggle="collapse" data-bs-target=".toggle-<%= story._id %>">Daha Az Göster 🔼</button>
                                </div>
                            <% } else { %>
                                <p class="card-text" style="white-space: pre-wrap;"><%= story.content %></p>
                            <% } %>
                            
                            <% if (user && user.username === story.author) { %>
                                <div class="d-flex mt-3 border-top pt-2">
                                    <a href="/edit/<%= story._id %>" class="btn btn-outline-warning btn-sm me-2">Düzenle</a>
                                    <form action="/delete/<%= story._id %>?_method=DELETE" method="POST">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>